  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flo-cg/guildmoji.git"
  },
  "bugs": {
    "url": "https://github.com/Flo-cg/guildmoji/issues"
  },
  "homepage": "https://github.com/Flo-cg/guildmoji#readme"
}
